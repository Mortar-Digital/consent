{
  "name": "mortar-digital/consent",
  "description": "Self-hosted cookie consent for WordPress: opt-in by category, script and embed gating, Consent Mode v2, and no third-party services.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "homepage": "https://mortar.digital/plugins/consent/",
  "authors": [
    {
      "name": "Mortar Digital",
      "homepage": "https://mortar.digital/"
    }
  ],
  "support": {
    "docs": "https://mortar.digital/plugins/consent/docs/",
    "issues": "https://github.com/Mortar-Digital/consent/issues",
    "source": "https://github.com/Mortar-Digital/consent",
    "security": "https://github.com/Mortar-Digital/consent/security"
  },
  "require": {
    "php": ">=8.2",
    "composer/installers": "^2.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5 || ^12.0",
    "phpstan/phpstan": "^2.1",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "php-cs-fixer/shim": "^3.95",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "autoload": {
    "psr-4": {
      "MortarDigital\\Consent\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MortarDigital\\Consent\\Tests\\": "tests/"
    }
  },
  "extra": {
    "installer-name": "mortar-consent"
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "8.2.0"
    }
  },
  "scripts": {
    "test": [
      "phpunit",
      "node --test --test-isolation=none 'tests/js/*.test.mjs'"
    ],
    "analyse": "phpstan analyse --no-progress --memory-limit=1G",
    "lint": [
      "php bin/lint",
      "@lint:js"
    ],
    "format": [
      "php-cs-fixer fix",
      "node node_modules/prettier/bin/prettier.cjs --write ."
    ],
    "format:check": [
      "php-cs-fixer fix --dry-run --diff",
      "node node_modules/prettier/bin/prettier.cjs --check ."
    ],
    "sniff": "phpcs",
    "check": [
      "@lint",
      "@format:check",
      "@sniff",
      "@analyse",
      "@test"
    ],
    "lint:js": "node node_modules/eslint/bin/eslint.js . --max-warnings=0"
  }
}
