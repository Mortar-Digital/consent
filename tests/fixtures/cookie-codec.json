{
  "_comment": "Shared by PHP (ConsentCookieCodecTest) and JS (tests/js/codec.test.mjs) so both sides agree on the cookie format.",
  "pattern": "^1\\|([1-9][0-9]{0,8})\\|([0-9]{1,12})\\|([0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})\\|((?:[a-z][a-z0-9_-]{0,31})(?:\\.[a-z][a-z0-9_-]{0,31})*)?$",
  "categories": [
    {
      "id": "necessary",
      "required": true
    },
    {
      "id": "analytics",
      "required": false
    },
    {
      "id": "marketing",
      "required": false
    }
  ],
  "cases": [
    {
      "name": "grants two categories",
      "value": "1|3|1761480000|3f1c2a9e-8b7d-4c2e-9f10-2a3b4c5d6e7f|analytics.marketing",
      "expect": {
        "policyVersion": 3,
        "timestamp": 1761480000,
        "consentId": "3f1c2a9e-8b7d-4c2e-9f10-2a3b4c5d6e7f",
        "granted": [
          "analytics",
          "marketing"
        ]
      }
    },
    {
      "name": "rejects all",
      "value": "1|1|1761480000|3f1c2a9e-8b7d-4c2e-9f10-2a3b4c5d6e7f|",
      "expect": {
        "policyVersion": 1,
        "timestamp": 1761480000,
        "consentId": "3f1c2a9e-8b7d-4c2e-9f10-2a3b4c5d6e7f",
        "granted": []
      }
    },
    {
      "name": "drops unknown and required categories",
      "value": "1|1|1761480000|3f1c2a9e-8b7d-4c2e-9f10-2a3b4c5d6e7f|necessary.ads.analytics",
      "expect": {
        "policyVersion": 1,
        "timestamp": 1761480000,
        "consentId": "3f1c2a9e-8b7d-4c2e-9f10-2a3b4c5d6e7f",
        "granted": [
          "analytics"
        ]
      }
    },
    {
      "name": "dedupes",
      "value": "1|1|1761480000|3f1c2a9e-8b7d-4c2e-9f10-2a3b4c5d6e7f|analytics.analytics",
      "expect": {
        "policyVersion": 1,
        "timestamp": 1761480000,
        "consentId": "3f1c2a9e-8b7d-4c2e-9f10-2a3b4c5d6e7f",
        "granted": [
          "analytics"
        ]
      }
    },
    {
      "name": "unknown schema",
      "value": "2|1|1761480000|3f1c2a9e-8b7d-4c2e-9f10-2a3b4c5d6e7f|analytics",
      "expect": null
    },
    {
      "name": "zero policy version",
      "value": "1|0|1761480000|3f1c2a9e-8b7d-4c2e-9f10-2a3b4c5d6e7f|analytics",
      "expect": null
    },
    {
      "name": "uppercase uuid",
      "value": "1|1|1761480000|3F1C2A9E-8B7D-4C2E-9F10-2A3B4C5D6E7F|analytics",
      "expect": null
    },
    {
      "name": "non-v4 uuid",
      "value": "1|1|1761480000|3f1c2a9e-8b7d-1c2e-9f10-2a3b4c5d6e7f|analytics",
      "expect": null
    },
    {
      "name": "trailing separator",
      "value": "1|1|1761480000|3f1c2a9e-8b7d-4c2e-9f10-2a3b4c5d6e7f|analytics.",
      "expect": null
    },
    {
      "name": "injected markup",
      "value": "1|1|1761480000|3f1c2a9e-8b7d-4c2e-9f10-2a3b4c5d6e7f|<script>",
      "expect": null
    },
    {
      "name": "trailing newline",
      "value": "1|1|1761480000|3f1c2a9e-8b7d-4c2e-9f10-2a3b4c5d6e7f|analytics\n",
      "expect": null
    },
    {
      "name": "missing segment",
      "value": "1|1|1761480000|analytics",
      "expect": null
    },
    {
      "name": "empty",
      "value": "",
      "expect": null
    }
  ]
}
