#!/usr/bin/env bash
# Builds the standalone plugin zip from this package:
#   bin/build-plugin            -> build/mortar-consent-<version>.zip
# Requires development dependencies (composer install; pnpm install).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
composer lint
node --test --test-isolation=none tests/js/build.test.mjs

VERSION="$(php -r 'echo json_decode(file_get_contents($argv[1]), true)["version"];' "$ROOT/composer.json")"
if [[ ! "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "Expected a stable x.y.z version in composer.json" >&2
  exit 1
fi
OUT="$ROOT/build"
STAGE="$OUT/mortar-consent"

rm -rf "$STAGE" "$OUT/mortar-consent-$VERSION.zip"
mkdir -p "$STAGE/assets" "$STAGE/languages"

cp -R "$ROOT/src" "$ROOT/blocks" "$ROOT/functions.php" "$STAGE/"
cp "$ROOT/assets/consent.js" "$ROOT/assets/consent.min.js" "$ROOT/assets/consent.css" "$ROOT/assets/admin.js" "$ROOT/assets/admin.css" "$STAGE/assets/"
cp "$ROOT/LICENSE" "$STAGE/"
cp "$ROOT/plugin/uninstall.php" "$STAGE/"
for file in mortar-consent.php readme.txt; do
  sed "s/__VERSION__/$VERSION/g" "$ROOT/plugin/$file" > "$STAGE/$file"
done

# Fail on any PHP syntax error in what ships.
find "$STAGE" -name '*.php' -print0 | xargs -0 -n1 php -l > /dev/null

(cd "$OUT" && zip -qr "mortar-consent-$VERSION.zip" mortar-consent)
echo "Built $OUT/mortar-consent-$VERSION.zip"
