#!/usr/bin/env bash
# Builds the WordPress.org plugin zip from the files that ship:
#   bin/build-plugin            -> build/mortar-consent-<version>.zip
# Requires development dependencies (composer install; pnpm install).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
composer lint
node --test --test-isolation=none tests/js/build.test.mjs

# The plugin header is the one place the version is set.
VERSION="$(sed -n 's/^ \* Version: *//p' "$ROOT/mortar-consent.php")"
if [[ ! "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "Expected a stable x.y.z Version in mortar-consent.php" >&2
  exit 1
fi
STABLE="$(sed -n 's/^Stable tag: *//p' "$ROOT/readme.txt")"
if [[ "$STABLE" != "$VERSION" ]]; then
  echo "readme.txt Stable tag ($STABLE) does not match the plugin Version ($VERSION)" >&2
  exit 1
fi
OUT="$ROOT/build"
STAGE="$OUT/mortar-consent"

rm -rf "$STAGE" "$OUT/mortar-consent-$VERSION.zip"
mkdir -p "$STAGE/assets"

cp -R "$ROOT/src" "$ROOT/blocks" "$STAGE/"
cp "$ROOT/mortar-consent.php" "$ROOT/uninstall.php" "$ROOT/functions.php" "$ROOT/readme.txt" "$ROOT/LICENSE" "$STAGE/"
cp "$ROOT/assets/consent.js" "$ROOT/assets/consent.min.js" "$ROOT/assets/consent-mode.js" "$ROOT/assets/consent.css" "$ROOT/assets/admin.js" "$ROOT/assets/admin.css" "$STAGE/assets/"

# Fail on any PHP syntax error in what ships.
find "$STAGE" -name '*.php' -print0 | xargs -0 -n1 php -l > /dev/null

(cd "$OUT" && zip -qr "mortar-consent-$VERSION.zip" mortar-consent)
echo "Built $OUT/mortar-consent-$VERSION.zip"
